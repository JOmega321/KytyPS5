#!/usr/bin/env bash
set -euo pipefail

appdir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export KYTY_APPIMAGE_DATA_DIR="${KYTY_APPIMAGE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/KytyPS5-PR1747}"
export XDG_CONFIG_HOME="${KYTY_PR1747_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/KytyPS5-PR1747}"
export XDG_CACHE_HOME="${KYTY_PR1747_CACHE_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/KytyPS5-PR1747}"
mkdir -p -- "$KYTY_APPIMAGE_DATA_DIR" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME"
export KYTY_APPIMAGE_DATA_DIR="$(cd -- "$KYTY_APPIMAGE_DATA_DIR" && pwd)"
cd -- "$KYTY_APPIMAGE_DATA_DIR"

if [[ "${1:-}" == "--emulator" ]]; then
    shift
    exec "$appdir/usr/bin/kyty_emulator" "$@"
fi
exec "$appdir/usr/bin/kyty_launcher" "$@"
